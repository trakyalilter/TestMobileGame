	"m025b": {"name": "Alloy Production", "desc": "On the Craft tab, smelt 50 Steel (Basic Steel Smelting recipe).", "type": "gather", "target": "Steel", "qty": 160, "cr": 18500, "xp": 500, "next": "m026"},
	"m026": {"name": "Master Constructor", "desc": "Research 'Shipwright I' for hull reinforcement. It bills 76 Steel (the stock you just smelted), 30 Circuit Boards, and 60 Common Artifacts from combat salvage — top up the circuits in Engineering before you open the node.", "type": "research", "target": "shipwright_1", "qty": 1, "cr": 18750, "xp": 500, "next": "m026b"},
	"m026b": {"name": "Hull Modernization I", "desc": "In the Shipyard, construct an Industrial Frigate hull.", "type": "construct", "target": "frigate_hull", "qty": 1, "cr": 38000, "xp": 1000, "next": "m026c"},
	"m026c": {"name": "Elite Salvage", "desc": "Defeated enemies drop gear of varying rarity. Farm Lunar Orbit on the Combat tab until you get a RARE (blue) module drop.", "type": "drop_rarity", "target": "2", "qty": 1, "cr": 19250, "xp": 500, "next": "m026d"},
	"m026d": {"name": "Combat Overhaul", "desc": "In the Ship Designer, equip at least one RARE+ weapon.", "type": "loadout_rare_weapon", "target": "2", "qty": 1, "cr": 39000, "xp": 1000, "next": "m026e"},
	"m026e": {"name": "Final Confrontation", "desc": "Defeat the Rogue Architect boss in Lunar Orbit.", "type": "defeat", "target": "z1_boss_architect", "qty": 1, "cr": 98750, "xp": 2500, "next": "m027"},
	"m027": {"name": "Scanning Horizon", "desc": "Research 'Asteroid Belt Authorization' in the Research tab to unlock the Asteroid Belt combat zone.", "type": "research", "target": "zone_2_access", "qty": 1, "cr": 20000, "xp": 500, "next": "m028"},
	"m028": {"name": "Belt Metallurgy", "desc": "On the Gather tab, mine 100 Cassiterite (tin ore).", "type": "gather", "target": "Sn", "qty": 70, "cr": 41000, "xp": 2000, "next": "m029"},
	"m029": {"name": "Hardened Shell", "desc": "In the Shipyard, build the Carbon Fiber Plate armor module.", "type": "craft", "target": "z2_armor", "qty": 1, "cr": 62250, "xp": 5000, "next": "m029a1"},
	"m029a1": {"name": "[TUTORIAL] Advanced Materials & Metallurgy", "desc": "On the Research tab, unlock Advanced Materials and Advanced Metallurgy to fabricate universal structural components.", "type": "research_multi", "target": ["adv_materials", "metallurgy_advanced"], "qty": 2, "cr": 42250, "xp": 1000, "next": "m029a3"},
	"m029a3": {"name": "First Components", "desc": "On the Craft tab, craft 10 Structural Components — the universal building block of heavy industry.", "type": "gather", "target": "StructuralComponent", "qty": 6, "cr": 34400, "xp": 1000, "next": "m029a4"},
	"m029a4": {"name": "[TUTORIAL] Combustion & Automation", "desc": "On the Research tab, unlock Organic Combustion and Factory Automation — the last gates before Advanced Circuits.", "type": "research_multi", "target": ["combustion", "automation"], "qty": 2, "cr": 65750, "xp": 1500, "next": "m029b"},
	"m029b": {"name": "Complex Electronics", "desc": "On the Craft tab, craft 5 Advanced Circuits (Semiconductor + Gold + Silver + Tin + Structural Components — your earlier research unlocked each one).", "type": "gather", "target": "AdvCircuit", "qty": 6, "cr": 94000, "xp": 5000, "next": "m030"},
	"m030": {"name": "Naval Expansion", "desc": "Research 'Shipwright II' to unlock Destroyer-class hulls.", "type": "research", "target": "shipwright_2", "qty": 1, "cr": 19000, "xp": 1000, "next": "m030c"},
	"m030c": {"name": "Hull Modernization II", "desc": "In the Shipyard, construct a Destroyer hull.", "type": "construct", "target": "destroyer_hull", "qty": 1, "cr": 120000, "xp": 2000, "next": "m030c2"},
	"m030c2": {"name": "Power Refit", "desc": "A Destroyer draws more power than your Zone-1 batteries supply. Fabricate 3 'Improved Battery' (Z2) and equip one per battery slot — you'll need the headroom for Zone-2 weapons.", "type": "craft", "target": "z2_battery", "qty": 3, "cr": 145500, "xp": 3000, "next": "m030c3"},
	"m030c3": {"name": "Heavier Ordnance", "desc": "Your Zone-1 guns barely dent Zone-2 armor. And the boss breaks the Belt's pattern: the Silicate Monolith shrugs off explosive and is WEAK TO ENERGY. Fabricate 4 'Plasma Cutter' (Z2 ENERGY) and equip one per weapon slot before the fight.", "type": "craft", "target": "z2_energy", "qty": 4, "cr": 147000, "xp": 3000, "next": "m030e"},
	"m030e": {"name": "Mars Beachhead", "desc": "Research 'Mars Debris Clearance' (spends the Monolith core you just salvaged) to unlock the Mars Debris zone.", "type": "research", "target": "zone_3_access", "qty": 1, "cr": 200000, "xp": 5000, "next": "m030f"},
	"m030f": {"name": "Salvage Operations", "desc": "On the Combat tab, defeat 3 Scavenger Mechs in the Mars Debris zone.", "type": "defeat", "target": "z3_scavenger_mech", "qty": 3, "cr": 303000, "xp": 8000, "next": "m030fa"},
	"m030fa": {"name": "Zone-3 Plating", "desc": "The Warmaster will shred Zone-2 armor. Fabricate 1 'Composite Plate' (Z3 armor) and equip one per armor slot.", "type": "craft", "target": "z3_armor", "qty": 1, "cr": 204000, "xp": 5000, "next": "m030fb"},
	"m030fb": {"name": "Zone-3 Shielding", "desc": "Reinforce your deflectors too. Fabricate 2 'Hardened Shield' (Z3) and equip one per shield slot before the Warmaster.", "type": "craft", "target": "z3_shield", "qty": 2, "cr": 206000, "xp": 5000, "next": "m030f1"},
	"m030f1": {"name": "Zone-3 Ordnance", "desc": "The Warmaster breaks the zone's pattern too: it is WEAK TO KINETIC, not energy. Fabricate 4 'Autocannon' (Z3 KINETIC) and equip one per weapon slot — swap before the fight.", "type": "craft", "target": "z3_kinetic", "qty": 4, "cr": 260000, "xp": 6000, "next": "m030g"},
	"m030g": {"name": "Glacier Belt Survey", "desc": "Research 'Glacier Belt Expedition' (spends the Warmaster core) to unlock the Glacier Belt zone.", "type": "research", "target": "zone_4_access", "qty": 1, "cr": 424000, "xp": 10000, "next": "m030h"},
	"m030h": {"name": "Frozen Frontier", "desc": "On the Combat tab, defeat 3 Ice Wraiths in the Cryofield. They drop Cryo Essence.", "type": "defeat", "target": "z4_ice_wraith", "qty": 3, "cr": 535000, "xp": 12000, "next": "m031"},
	"m031": {"name": "Alpha Decryption", "desc": "Research 'Sector Alpha Decryption' (consumes the Overseer cores + a stock of Superalloy — craft it in Engineering) to breach Sector Alpha.", "type": "research", "target": "zone_5_access", "qty": 1, "cr": 277500, "xp": 10000, "next": "m032"},
	"m032": {"name": "Alpha Sector Dominance", "desc": "Defeat 3 Alien Frigates in Sector Alpha.", "type": "defeat", "target": "z5_alien_frigate", "qty": 3, "cr": 420000, "xp": 15000, "next": "m032b"},
	"m032b": {"name": "Beta Colony Charter", "desc": "Research 'Deep Space Navigation' on the Zones research tab to unlock Sector Beta.", "type": "research", "target": "zone_6_access", "qty": 1, "cr": 290000, "xp": 5000, "next": "m032d"},
	"m032d": {"name": "Void Research", "desc": "Void Artifacts drop from Sector Alpha ships — defeat them on the Combat tab until you collect 5.", "type": "gather", "target": "VoidArtifact", "qty": 5, "cr": 585000, "xp": 10000, "next": "m032c"},
	"m032c": {"name": "Capital Doctrine", "desc": "In the Shipyard, construct a Battlecruiser.", "type": "construct", "target": "battlecruiser_hull", "qty": 1, "cr": 1412500, "xp": 25000, "next": "m033"},
	"m033": {"name": "Beta Sector Expansion", "desc": "Defeat 5 Ore Guardians in Sector Beta.", "type": "defeat", "target": "z6_ore_guardian", "qty": 5, "cr": 885000, "xp": 25000, "next": "m033b"},
	"m033b": {"name": "Gamma Clearance", "desc": "Research 'Radiation Shielding' on the Zones research tab to unlock Sector Gamma. It costs 3 Beta Cores — the Sector Beta boss (Gamma Colossus) drops them.", "type": "research", "target": "zone_7_access", "qty": 1, "cr": 610000, "xp": 10000, "next": "m033c"},
	"m033c": {"name": "Titan Construction", "desc": "In the Shipyard, construct a Dreadnought.", "type": "construct", "target": "dreadnought_hull", "qty": 1, "cr": 6150000, "xp": 50000, "next": "m034"},
	"m034": {"name": "Break the Blockade", "desc": "Defeat 3 Gamma Colossus — the Sector Beta boss — to finalize your supremacy.", "type": "defeat", "target": "z6_boss_colossus", "qty": 3, "cr": 1815000, "xp": 50000, "next": ""},
	"goal_001": {"name": "THE GREAT EXPEDITION", "desc": "Reach Sector Epsilon and discover the Primordial Core.", "type": "discover", "target": "sector_epsilon", "qty": 1, "cr": 1550000, "xp": 0, "next": ""},
	"goal_002": {"name": "INTO THE VOID", "desc": "Perform your first Warp. Your Liras and materials reset, but you gain Exotic Matter Shards for permanent multipliers that make each run stronger.", "type": "warp_perform", "target": "warp", "qty": 1, "cr": 312500, "xp": 0, "next": ""},
	"goal_003": {"name": "PRESTIGE VETERAN", "desc": "Perform 5 Warps total to fully unlock Warp Tier scaling.", "type": "warp_perform", "target": "warp", "qty": 5, "cr": 3150000, "xp": 0, "next": ""},
	"goal_boost_1": {"name": "OVERCLOCK PROTOCOL", "desc": "Your grid can run hotter. Fabricate a Boost Card in the Craft tab — it takes Advanced Circuits, Superalloy, and a Quantum Core (Sector Alpha hostiles drop them).", "type": "gather", "target": "BoostCard", "qty": 1, "cr": 266000, "xp": 0, "next": "goal_boost_2"},
	"goal_boost_2": {"name": "RUNNING HOT", "desc": "Open Infrastructure and INSTALL the Boost Card on a building you own — it unlocks that building's Efficiency slider up to 200%. Careful: output scales linearly, but input draw scales QUADRATICALLY (200% output = 4x input).", "type": "overclock_install", "target": "BoostCard", "qty": 1, "cr": 402000, "xp": 0, "next": ""},
	"goal_cryo_1": {"name": "FORGE CRYOGENIC ARMS", "desc": "The Threshold (Sector 11) is warp-hardened — only Cryo weapons breach it. Research Cryogenic Armaments in the Warp Tech tab (prereqs: Energy Metrics, then Cryogenic Systems).", "type": "research", "target": "cryo_armaments", "qty": 1, "cr": 19050000, "xp": 0, "next": "goal_cryo_2"},
	"goal_cryo_2": {"name": "FORGE CRYOGENIC ARMS", "desc": "Craft a Cryo Lance in the Ship Designer. It needs Cryo Catalyst - farm it from Sector 10 enemies.", "type": "craft", "target": "cryo_lance", "qty": 1, "cr": 38400000, "xp": 0, "next": "goal_cryo_3"},
	"goal_cryo_3": {"name": "BREACH THE THRESHOLD", "desc": "Destroy a Warp Revenant in The Threshold (Sector 11) with your Cryo armaments.", "type": "defeat", "target": "z11_warp_revenant", "qty": 1, "cr": 96750000, "xp": 0, "next": ""},
	"goal_hack_1": {"name": "REWRITE THE FIRMWARE", "desc": "Salvaged modules can be re-forged. In the Research Lab, open the Combat category: research Kinetic Weapons Theory, then Firmware Hacking beneath it, to unlock Hack Cards — module affix crafting.", "type": "research", "target": "firmware_hacking", "qty": 1, "cr": 130000, "xp": 0, "next": "goal_hack_2"},
	"goal_hack_2": {"name": "SALVAGE A HACK CARD", "desc": "Hack Cards now drop in combat. Defeat enemies until a Splice Chip drops.", "type": "gather", "target": "SpliceChip", "qty": 1, "cr": 98250, "xp": 0, "next": "goal_hack_3"},
	"goal_hack_3": {"name": "AWAKEN A MODULE", "desc": "Open the Ship Designer and drag a Splice Chip onto a Common component to awaken it into a custom module with a random affix.", "type": "hack_apply", "target": "SpliceChip", "qty": 1, "cr": 198000, "xp": 0, "next": ""},
	"goal_matrix_1": {"name": "ATTUNE A MATRIX CORE", "desc": "Rare, Legendary and Unique modules carry SOCKETS. In the Ship Designer, craft 'Matrix Synthesis' to synthesize a Matrix Core — a gem that empowers whatever module you socket it into.", "type": "craft_matrix", "target": "matrix", "qty": 1, "cr": 270000, "xp": 0, "next": "goal_matrix_2"},
	"goal_matrix_2": {"name": "SLOT THE CORE", "desc": "Open the Ship Designer and drag your Matrix Core from the Armory onto an empty socket on one of your EQUIPPED modules. Its facet bonus applies while that module stays equipped.", "type": "socket_check", "target": "matrix", "qty": 1, "cr": 408000, "xp": 0, "next": ""},
	"m005b": {"name": "Power Cells", "desc": "You have the iron and the lithium. In the Ship Designer, craft 2 'Basic Battery' modules — every module you equip draws power, and these are what supply it.", "type": "craft", "target": "z1_battery", "qty": 2, "cr": 2025, "xp": 200, "next": "m005c"},
	"m005c": {"name": "Power Online", "desc": "Open the Ship Designer and equip BOTH Basic Batteries into the ship's BATTERY slots. Watch the GRID fill — now the ship can run modules.", "type": "loadout_check", "target": "battery", "qty": 2, "cr": 1120, "xp": 150, "next": "m007"},
	"m017a": {"name": "Energy Doctrine", "desc": "Not every hostile falls to slugs. The Silicate Golem in the Asteroid Belt RESISTS kinetic fire but is WEAK TO ENERGY. In the Ship Designer, craft 3 'Pulse Laser Mk.I' — your Frigate carries three weapon mounts.", "type": "craft", "target": "z1_energy", "qty": 3, "cr": 3375, "xp": 200, "next": "m017a2"},
	"m017a2": {"name": "Charge the Crystals", "desc": "The Pulse Laser runs on Focus Crystals. In the Craft tab, produce 90 Focus Crystals", "type": "gather", "target": "CellT1", "qty": 90, "cr": 3449, "xp": 200, "next": "m017b"},
	"m017b": {"name": "Pulse Fire", "desc": "Keep builds in separate slots: click LOADOUT 2, equip all THREE Pulse Lasers there, then destroy a Silicate Golem in the Asteroid Belt.", "type": "defeat", "target": "z2_silicate_golem", "qty": 1, "cr": 7050, "xp": 500, "next": "m027b"},
	"m017c": {"name": "Explosive Doctrine", "desc": "The Scavenger Mech in Mars Debris is armored against kinetic but blows apart under EXPLOSIVE ordnance. In the Ship Designer, craft 4 'Micro-Missile Launcher' — one for each of the Destroyer's four weapon mounts.", "type": "craft", "target": "z1_missile", "qty": 4, "cr": 4320, "xp": 250, "next": "m017c2"},
	"m017c2": {"name": "Stock the Warheads", "desc": "The launcher fires Missiles. In the Craft tab, produce 120 HE Missiles.", "type": "gather", "target": "MissileT1", "qty": 120, "cr": 4410, "xp": 250, "next": "m017d"},
	"m017d": {"name": "Warhead", "desc": "Click LOADOUT 3, equip all FOUR Micro-Missile Launchers there, then destroy a Scavenger Mech in Mars Debris. Kinetic / Energy / Explosive now live in Loadouts 1 / 2 / 3 — before a fight, one click swaps your WHOLE ship modules.", "type": "defeat", "target": "z3_scavenger_mech", "qty": 1, "cr": 8750, "xp": 600, "next": "m030f"},
	"m018t1": {"name": "Tin Prospecting", "desc": "In the Gather tab, extract 40 Cassiterite (tin ore). It smelts into the Tin your circuits will need.", "type": "gather", "target": "Cassiterite", "qty": 40, "cr": 3975, "xp": 200, "next": "m018t2"},
	"m018t2": {"name": "Tin Smelting", "desc": "In the Craft tab, smelt Cassiterite into 24 Tin (Sn) — the 'Tin Smelting' recipe (it also uses a little Carbon).", "type": "gather", "target": "Sn", "qty": 24, "cr": 4050, "xp": 200, "next": "m019"},
	"m019b": {"name": "Cargo Hold", "desc": "Open your Inventory (More menu). Cargo is slot-limited — when it fills, new materials are LOST, not paused. Expand storage here as you grow.", "type": "visit_page", "target": "inventory", "qty": 1, "cr": 5600, "xp": 200, "next": "m019c"},
	"m019c": {"name": "Background Industry", "desc": "Open Infrastructure (More menu). Buildings auto-produce in the background — always running, even offline. Build them whenever you can.", "type": "visit_page", "target": "infrastructure", "qty": 1, "cr": 5700, "xp": 200, "next": "m019d"},
	"m019e": {"name": "Field Manual", "desc": "The next research, Efficient Smelting, needs COMMON ARTIFACT — a material you don't craft or mine. When a mission names something you don't recognise, the ATLAS shows where it comes from. Open the Atlas (More menu), switch to the MATERIALS tab, type \"Common Artifact\" in the search box, and open its entry to see which enemies drop it.", "type": "atlas_lookup", "target": "Res1", "qty": 1, "cr": 5900, "xp": 150, "next": "m025"},
	"m024a1": {"name": "Plate the Hull", "desc": "Craft an 'Iron Plate' in the Ship Designer for hull armor.", "type": "craft", "target": "z1_armor", "qty": 1, "cr": 8375, "xp": 200, "next": "m024a2"},
	"m024a2": {"name": "Bolt It On", "desc": "Open the Ship Designer, then DRAG the Iron Plate from your Armory onto the empty ARMOR slot. It cuts incoming hull damage.", "type": "loadout_check", "target": "armor", "qty": 1, "cr": 1700, "xp": 100, "next": "m024b"},
	"m025a": {"name": "Split the Water", "desc": "Modern foundries burn Oxygen. In the Craft tab, run Water Electrolysis to split Water — stock 70 Oxygen. The steel run ahead burns 2 per batch.", "type": "gather", "target": "O", "qty": 70, "cr": 10950, "xp": 300, "next": "m025b"},
	"m027b": {"name": "Open Contracts", "desc": "Open Bounties (More menu — it just unlocked). Each sector runs its own combat contract board: accept one, and kills in that sector count toward it automatically. Pays Liras + a ship module.", "type": "visit_page", "target": "bounty", "qty": 1, "cr": 24300, "xp": 500, "next": "m028"},
	"m029a6": {"name": "Industrial Baseload", "desc": "Construct 2 Biomass Plants in Infrastructure — 1,000 kW each. The assembly line ahead draws 1,500 kW, so a single plant leaves it starved. They burn Wood, so keep a stock coming.", "type": "build", "target": "biomass_plant", "qty": 2, "cr": 53400, "xp": 1500, "next": "m029a6t"},
	"m029a6t": {"name": "Titanium Reduction", "desc": "The industrial tier runs on titanium. In the Gather tab quarry Dolomite, then run Titanium Reduction in Engineering until you hold 100 Ti — Automated Smelting takes 40 and the assembler after it takes 50.", "type": "gather", "target": "Ti", "qty": 100, "cr": 45000, "xp": 1200, "next": "m029a7"},
	"m029a7": {"name": "Industrial Automation", "desc": "Research 'Industrial Automation'. The Infrastructure branch runs Blast Furnace → Automated Smelting → Industrial Automation, and Automated Smelting spends 40 of your titanium. Hand-soldering ends here.", "type": "research", "target": "industrial_automation", "qty": 1, "cr": 36400, "xp": 1000, "next": "m029a8"},
	"m029a8": {"name": "The Assembly Line", "desc": "Commission an Electronics Assembler. It costs 25,000 Liras, 50 Titanium, 40 Circuit Boards and 12 Salvage Data — Pirate Skiffs in the Asteroid Belt sometimes carry Salvage Data, so clear Belt hostiles if you are short. It draws 1,500 kW, which your two Biomass Plants cover. It consumes Silicon, Copper and Resin from storage.", "type": "build", "target": "electronics_assembler", "qty": 1, "cr": 92000, "xp": 2500, "next": "m029a9"},
	"m029a9": {"name": "Passive Supply", "desc": "Accumulate 100 Circuits. The Assembler produces them while you mine, fight — or sleep. Hand-crafting still works; the line just never gets tired.", "type": "gather", "target": "Circuit", "qty": 100, "cr": 116250, "xp": 4000, "next": "m029b"},
	"m030d": {"name": "Belt Overseer", "desc": "Defeat the Silicate Monolith (Asteroid Belt boss) to salvage a Z2 Sector Core for the Mars Debris charter. Bosses demand a full RARE loadout — Common and Uncommon gear will not cut through. Work the Asteroid Belt BOUNTY BOARD: hunt contracts pay a GUARANTEED Rare module on claim. ENERGY hits it hardest — swap loadouts before the fight.", "type": "defeat", "target": "z2_boss_monolith", "qty": 1, "cr": 247500, "xp": 6000, "next": "m030e"},
	"m030f2": {"name": "Warmaster's Core", "desc": "Defeat the Martian Warmaster (Mars Debris boss) — its core decrypts the Glacier Belt charter.", "type": "defeat", "target": "z3_boss_warmaster", "qty": 1, "cr": 472500, "xp": 12000, "next": "m030g"},
	"m030h1": {"name": "Hull Modernization III", "desc": "Construct a 'Heavy Cruiser' in the Ship Designer. A Destroyer frame cannot carry you through the Glacial Overseer no matter how good its modules are — the tier-4 hull more than doubles your integrity and power capacity, and adds a weapon and an armor slot. Its frame needs 15 Wreckforged Alloy: refine it in Engineering from Chondrite Alloy, Steel and Martian Relics.", "type": "construct", "target": "cruiser_hull", "qty": 1, "cr": 594000, "xp": 13000, "next": "m030h2"},
	"m030h2": {"name": "Power Refit II", "desc": "A Heavy Cruiser carries five weapon mounts and two armor plates, and your Zone-2 cells cannot feed them — you have been running Belt-era power since the Destroyer refit. Fabricate 3 'Mg-Ion Cell' (Z4) and equip one per battery slot.", "type": "craft", "target": "z4_battery", "qty": 3, "cr": 626750, "xp": 14000, "next": "m030i"},
	"m030i": {"name": "Overseer's Core", "desc": "Decrypting the Sector Alpha charter takes two Glacial Overseer cores — defeat the Glacier Belt boss twice.", "type": "defeat", "target": "z4_boss_overseer", "qty": 2, "cr": 660000, "xp": 15000, "next": "m031"},
	"m032a": {"name": "Harbinger Hunt", "desc": "The Beta Colony Charter demands three XENON HARBINGER cores. Defeat the Sector Alpha boss three times.", "type": "defeat", "target": "z5_boss_harbinger", "qty": 3, "cr": 862500, "xp": 20000, "next": "m032b"},
	"m032c2": {"name": "Power Refit III", "desc": "A Battlecruiser's fourth battery bay is empty and your Glacier-era cells cannot feed six weapon mounts. Fabricate 4 'Mg-Ion Cell' (Z4) and equip one per battery slot.", "type": "craft", "target": "z4_battery", "qty": 4, "cr": 1140000, "xp": 20000, "next": "m032a"},
	"m033a1": {"name": "Hull Modernization IV", "desc": "Construct a 'Capital Ship' in the Ship Designer. The Beta Colossus is a tier-6 fight — the capital frame carries a seventh weapon mount and a third deflector. Its keel needs 12 Xenoforged Alloy, refined in Engineering.", "type": "construct", "target": "capital_hull", "qty": 1, "cr": 1785000, "xp": 30000, "next": "m033a2"},
	"m033a2": {"name": "Power Refit IV", "desc": "Four empty bays and seven weapon mounts to feed. Fabricate 4 'Reactive Core' (Z6) and equip one per battery slot — assemble them in Engineering from Sector Beta colony salvage.", "type": "craft", "target": "z6_battery", "qty": 4, "cr": 1800000, "xp": 30000, "next": "m034"},
}
