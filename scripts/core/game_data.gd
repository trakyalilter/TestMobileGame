func res_name(sym: String) -> String:
	return RESOURCES.get(sym, {}).get("name", sym)

func color_for(sym: String) -> Color:
	return Color.html(RESOURCES.get(sym, {}).get("color", "ffffff"))

func value_of(sym: String) -> int:
	return int(RESOURCES.get(sym, {}).get("value", 0))

func fmt(n) -> String:
	var v := int(n)
	if v >= 1000000: return "%.2fM" % (v / 1000000.0)
	if v >= 1000: return "%.1fK" % (v / 1000.0)
	return str(v)
