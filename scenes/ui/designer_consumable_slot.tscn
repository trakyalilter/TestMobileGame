[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/designer_consumable_slot.gd" id="1_script"]

[node name="DesignerConsumableSlot" type="PanelContainer"]
custom_minimum_size = Vector2(180, 50)
offset_right = 180.0
offset_bottom = 50.0
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 4

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Icon" type="Label" parent="Margin/HBox"]
custom_minimum_size = Vector2(30, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "💊"
horizontal_alignment = 1
vertical_alignment = 1

[node name="VBox" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1

[node name="TypeLabel" type="Label" parent="Margin/HBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 9
text = "HULL REPAIR"

[node name="NameLabel" type="Label" parent="Margin/HBox/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Effective Nanow... (x5)"
text_overrun_behavior = 3

[node name="EjectBtn" type="Button" parent="Margin/HBox"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(1, 0.4, 0.4, 1)
text = "×"
flat = true

[node name="SelectBtn" type="TextureButton" parent="."]
layout_mode = 2
mouse_filter = 1

[connection signal="pressed" from="Margin/HBox/EjectBtn" to="." method="_on_eject_btn_pressed"]
[connection signal="pressed" from="SelectBtn" to="." method="_on_select_btn_pressed"]
