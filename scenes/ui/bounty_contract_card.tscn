[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/bounty_contract_card.gd" id="1"]

[node name="BountyContractCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 100)
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Contract Title"
theme_override_font_sizes/font_size = 14

[node name="DescLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Contract description"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.6, 0.6, 0.7, 1)
autowrap_mode = 2

[node name="ProgressBar" type="ProgressBar" parent="Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)
max_value = 100.0
value = 0.0
show_percentage = false

[node name="RewardLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Reward: 1,000 CR"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)

[node name="ActionBtn" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "ACCEPT"
