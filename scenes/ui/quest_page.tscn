[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/quest_page.gd" id="1"]

[node name="QuestPage" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HeaderHBox" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Margin/VBox/HeaderHBox"]
layout_mode = 2
size_flags_horizontal = 3
text = "STANDING ORDERS"
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.55, 0.95, 1, 1)

[node name="StatsLabel" type="Label" parent="Margin/VBox/HeaderHBox"]
layout_mode = 2
text = "Completed: 0"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.55, 0.6, 0.72, 1)

[node name="SubtitleLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Persistent orders from the Command Network. Quests track passively across all systems — no need to accept. Claim rewards as objectives complete. New orders are issued on each claim."
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.5, 0.55, 0.65, 1)
autowrap_mode = 2

[node name="ControlsHBox" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 8

[node name="ClaimAllBtn" type="Button" parent="Margin/VBox/ControlsHBox"]
layout_mode = 2
disabled = true
text = "CLAIM ALL (0)"

[node name="RerollBtn" type="Button" parent="Margin/VBox/ControlsHBox"]
layout_mode = 2
text = "REROLL BOARD (2.5K CR)"

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="QuestGrid" type="GridContainer" parent="Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
columns = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10
