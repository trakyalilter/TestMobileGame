[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/quest_card.gd" id="1"]

[node name="QuestCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 130)
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="HeaderHBox" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Margin/VBox/HeaderHBox"]
layout_mode = 2
size_flags_horizontal = 3
text = "Order Title"
theme_override_font_sizes/font_size = 13

[node name="TierLabel" type="Label" parent="Margin/VBox/HeaderHBox"]
layout_mode = 2
text = "T1"
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.55, 0.65, 0.85, 1)

[node name="DescLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Order description"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.62, 0.66, 0.74, 1)
autowrap_mode = 2

[node name="ProgressLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "0 / 0"
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.78, 0.78, 0.84, 1)

[node name="ProgressBar" type="ProgressBar" parent="Margin/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)
max_value = 100.0
value = 0.0
show_percentage = false

[node name="RewardLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Reward: 0 CR"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)

[node name="ClaimBtn" type="Button" parent="Margin/VBox"]
layout_mode = 2
disabled = true
text = "IN PROGRESS"
