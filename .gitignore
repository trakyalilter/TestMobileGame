# Godot-specific ignores
.godot/
*.tmp
*.out
*.log
*.console_history
*.pck

# Imported translations (if any)
*.translation

# Export builds (typical folder, though not strictly standard)
build/
export/

# Project-specific Files (User Request)
# "Original project files" (Python Source)
src/
__pycache__/
*.pyc

# User Data / Saves
# It is good practice to ignore local save files
user://

# Mono/C# (If used later, harmless to add)
.mono/
*.csproj
*.sln
*.a
*.lib
*.dll
*.so
*.dylib

# OS-specific
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local agent state + worktrees + session data (machine-specific, large; not shared)
.claude/

# Temp icon-revision working dir + headless sim run logs (transient/generated)
tmp_iconrev/
_bot_out.txt
_bot_a.txt
_bot_*.txt
sim_out/

# Android exports + signing material. Binaries belong on GitHub Releases
# (see .github/workflows/android-release.yml), never in git history.
*.apk
*.aab
*.keystore
*.jks
# EXCEPT the CI debug keystore: deliberately committed so every dev build
# carries the SAME signature and Android installs each one as an update rather
# than refusing it with "package conflicts with an existing package". Throwaway
# key, conventional `android` password. The real RELEASE key must never be
# committed — it belongs in a repository secret.
!ci-debug.keystore
